# Option A (recommended): let ForgeBench store the key for you.
#   forgebench set-key          # hidden prompt, saves this file, chmod 600
#   forgebench set-key --show   # masked status check
#
# Option B: copy this file to .env and fill it in by hand.
# Either way .env is git-ignored. The mock provider needs no credentials.
MISTRAL_API_KEY=
# Current lineup (verified 2026-10-15): ministral-8b-2512, ministral-14b-2512,
# mistral-small-4-0-26-03, mistral-large-3-25-12, mistral-medium-3-5-26-04.
# Check https://docs.mistral.ai/models/ for current ids and license terms.
MISTRAL_MODEL=ministral-8b-2512

# OpenRouter: one key for hundreds of models from many vendors. Model ids are
# namespaced, e.g. anthropic/claude-3.5-sonnet, openai/gpt-4o,
# meta-llama/llama-3.1-70b-instruct, google/gemini-2.5-pro.
# List them with: forgebench models --provider openrouter --live
OPENROUTER_API_KEY=
