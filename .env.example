# Option A (recommended): let ForgeBench store the key for you.
#   forgebench set-key                     # OpenRouter (the default), hidden prompt
#   forgebench set-key --provider mistral  # any other provider
#   forgebench set-key --show              # masked status check
#
# Option B: copy this file to .env and fill it in by hand.
# Either way .env is git-ignored. The mock provider needs no credentials.

# OpenRouter (default): one key for hundreds of models from many vendors.
# Model ids are namespaced, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet,
# meta-llama/llama-3.1-70b-instruct. List them with:
#   forgebench models --provider openrouter --live
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Mistral. Current lineup (verified 2026-10-15): ministral-8b-2512,
# ministral-14b-2512, mistral-small-4-0-26-03, mistral-large-3-25-12,
# mistral-medium-3-5-26-04. Check https://docs.mistral.ai/models/ for current ids.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512

# Credits monetization (sandbox-safe). See services/stripe_webhook/README.md.
# Webhook signing secret — from `stripe listen` (CLI) or a Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=
# Per-package checkout links (test mode for sandbox, live keys for production).
# The dashboard shows a Buy link per package when these are set.
STRIPE_LINK_STARTER_50=
STRIPE_LINK_GROWTH_100=
STRIPE_LINK_SCALE_250=
STRIPE_LINK_MAX_500=
STRIPE_LINK_DATASET_PACK=
STRIPE_LINK_ENTERPRISE_UNLIMITED=
# Fallback when checkout metadata is missing: price_id=package, comma separated.
STRIPE_PRICE_MAP=
